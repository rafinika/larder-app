{
  "name": "larder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,worker -c blue,green \"vite\" \"wrangler dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "db:init": "wrangler d1 execute larder-db --file=./schema.sql",
    "db:init:local": "wrangler d1 execute larder-db --local --file=./schema.sql"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11",
    "wrangler": "^3.99.0"
  }
}
